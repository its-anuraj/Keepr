# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
**/.env
**/.env.*
!**/.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# development only (scratch/ is a local-only dev artifact dump, not version controlled)
scratch/

# IDE and tooling local state
.claude/

# Supabase local CLI cache
supabase/.temp/

